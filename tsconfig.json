{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    // `worker-configuration.d.ts` is generated by `npm run types`, and it is the
    // Workers runtime library. It replaced `@cloudflare/workers-types`, which
    // wrangler 4.123 supersedes and says so on every `wrangler types` run.
    //
    // The improvement is that the types now come from the installed workerd and
    // this repo's own `compatibility_date` rather than from whatever version of a
    // separate package happened to resolve — one fewer thing that can disagree
    // with the runtime the specs actually boot. The file's header names both, so
    // a surprising type error has somewhere to start.
    //
    // Generated with `--include-env=false`, and that flag is load-bearing rather
    // than tidiness. The whole point of config-at-instantiation is that a plugin
    // never names a consumer's ambient `Env`; the default output declares a global
    // `Env` built from *this* repo's dev-only `wrangler.jsonc` bindings, so
    // including it would make a stray `Env` reference typecheck here and then
    // resolve to a consumer's bindings at their build, where the mistake is
    // invisible. Without it there is no global `Env` to reach for and the mistake
    // fails here, which is the property the old `@cloudflare/workers-types` entry
    // got by leaving this file out entirely.
    //
    // A path rather than a package name, which `types` accepts: this is a file in
    // the repo, not a package under `node_modules/@types`.
    //
    // Committed, despite being generated. It is an input to `tsc` and to eslint's
    // type-aware pass, so leaving it untracked means a fresh clone cannot
    // typecheck until someone runs a script — and an editor opened before that
    // shows a few thousand phantom errors. `npm run types:check` is what keeps a
    // committed copy honest: it fails `check` when this file no longer matches
    // `wrangler.jsonc` and the installed workerd, which are its only two inputs.
    // Regenerate with `npm run types` and commit the result.
    //
    // `@cloudflare/vitest-plugin/types` is here for the specs, which run
    // inside workerd and import `cloudflare:test`.
    "types": [
      "./worker-configuration.d.ts",
      "@cloudflare/vitest-plugin/types",
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  // Specs included, because eslint's type-aware pass resolves each file to its
  // nearest tsconfig and a co-located spec excluded here would have no project.
  // `tsconfig.build.json` is where specs are held out of `dist/`.
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
